## Path is resolved relative to the `android/` folder (rootProject).
## Common locations:
## - `android/app/upload-keystore.jks`  -> storeFile=app/upload-keystore.jks
## - repo root `upload-keystore.jks`    -> storeFile=../upload-keystore.jks
storeFile=app/upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
